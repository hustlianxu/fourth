/* pages/dict/dict.wxss */
.container {
  padding: 0 24rpx 24rpx;
}

/* ===== 顶部 Tab ===== */
.tabs {
  display: flex;
  background: #fff;
  margin: 0 -24rpx 24rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
  transition: color 0.2s;
}

.tab.active {
  color: #07c160;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #07c160;
  border-radius: 2rpx;
}

/* ===== 通用区块 ===== */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 8rpx;
}

.section-desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

/* ===== 空状态 ===== */
.empty {
  text-align: center;
  padding: 64rpx 0;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-title {
  font-size: 30rpx;
  color: #333;
  margin-top: 12rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.empty-mini {
  text-align: center;
  padding: 32rpx 0;
  color: #bbb;
  font-size: 26rpx;
}

/* ===== 词典列表 ===== */
.dict-list {
  margin-top: 8rpx;
}

.dict-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.dict-item:last-child {
  border-bottom: none;
}

.dict-item.builtin {
  padding: 16rpx;
}

.dict-item-body {
  flex: 1;
}

.dict-pair {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
}

.dict-zh {
  color: #222;
  font-weight: 500;
}

.dict-arrow {
  color: #bbb;
  font-size: 24rpx;
}

.dict-es {
  color: #555;
}

.dict-item-actions {
  display: flex;
  gap: 24rpx;
}

.link {
  font-size: 24rpx;
  padding: 8rpx 12rpx;
}

.link.edit {
  color: #07c160;
}

.link.del {
  color: #ff4d4f;
}

/* ===== 按钮 ===== */
.btn {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  transition: opacity 0.15s, transform 0.1s;
}

.btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn.secondary {
  background: #fff;
  color: #07c160;
  border: 2rpx solid #07c160;
  box-sizing: border-box;
}

.btn.add-btn {
  margin-top: 24rpx;
}

.btn.save-btn {
  margin-top: 24rpx;
}

.btn.test-btn {
  background: #fff;
  color: #07c160;
  border: 2rpx solid #07c160;
  margin-top: 16rpx;
  box-sizing: border-box;
}

/* ===== 搜索栏 ===== */
.search-bar {
  margin-bottom: 16rpx;
}

.search-input {
  width: 100%;
  background: #f7f8fa;
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  min-height: 80rpx;
  line-height: 1.5;
}

/* ===== 表单 ===== */
.form-item {
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 26rpx;
  color: #555;
  margin-bottom: 8rpx;
}

/* 开关行：标签 + switch 同行 */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.switch-row .form-label {
  margin-bottom: 0;
}

.form-input {
  width: 100%;
  background: #f7f8fa;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  min-height: 80rpx;
  line-height: 1.5;
}

/* ===== 服务商选择（横向滚动） ===== */
.provider-scroll {
  width: 100%;
  white-space: nowrap;
}

.provider-list {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.provider-chip {
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
  box-sizing: border-box;
  white-space: nowrap;
  flex-shrink: 0;
}

.provider-chip.on {
  background: rgba(7, 193, 96, 0.1);
  color: #07c160;
  border-color: #07c160;
  font-weight: 600;
}

/* ===== 警告 ===== */
.api-warn {
  background: rgba(255, 165, 0, 0.08);
  border-left: 6rpx solid #ffa500;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #b36b00;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

/* ===== 测试结果 ===== */
.test-result {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
}

.test-result-title {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.test-result-text {
  font-size: 26rpx;
  color: #222;
  word-break: break-all;
  white-space: pre-wrap;
  line-height: 1.6;
}

/* ===== 白名单 ===== */
.whitelist-group {
  margin-top: 24rpx;
}

.whitelist-group-title {
  font-size: 26rpx;
  color: #555;
  margin-bottom: 12rpx;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 10rpx 20rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.chip-builtin {
  background: #f0f0f0;
  color: #666;
}

.chip-removable {
  background: rgba(7, 193, 96, 0.08);
  color: #07c160;
  border: 2rpx solid rgba(7, 193, 96, 0.3);
  box-sizing: border-box;
}

.chip-x {
  font-size: 22rpx;
  color: #07c160;
  padding-left: 8rpx;
}

.whitelist-add {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
  align-items: center;
}

.whitelist-input {
  flex: 1;
  background: #f7f8fa;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  min-height: 80rpx;
}

.whitelist-add-btn {
  flex-shrink: 0;
  padding: 20rpx 32rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

/* ===== Prompt 编辑 ===== */
.prompt-section {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.form-textarea {
  width: 100%;
  background: #f7f8fa;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  line-height: 1.6;
  min-height: 200rpx;
  margin-bottom: 16rpx;
}

.placeholder-tag {
  display: inline-block;
  background: rgba(7, 193, 96, 0.1);
  color: #07c160;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  margin: 0 2rpx;
}

.prompt-actions {
  display: flex;
  gap: 16rpx;
}

.prompt-btn {
  flex: 1;
  padding: 22rpx;
  font-size: 30rpx;
}

.prompt-preview {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  border-left: 6rpx solid #07c160;
}

.prompt-preview-title {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.prompt-preview-text {
  font-size: 24rpx;
  color: #444;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

/* ===== 编辑弹层 ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.modal {
  position: fixed;
  left: 60rpx;
  right: 60rpx;
  top: 30%;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  z-index: 102;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 20rpx;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.modal-actions .btn {
  flex: 1;
  padding: 22rpx;
  font-size: 30rpx;
}

/* ===== 暗黑模式 ===== */
@media (prefers-color-scheme: dark) {
  .tabs {
    background: rgb(17, 17, 17);
    border-bottom-color: rgb(40, 40, 40);
  }

  .tab {
    color: rgb(149, 149, 149);
  }

  .tab.active {
    color: rgb(0, 200, 80);
  }

  .tab.active::after {
    background: rgb(0, 200, 80);
  }

  .section {
    background: rgb(17, 17, 17);
  }

  .section-title {
    color: rgb(231, 231, 231);
  }

  .section-desc {
    color: rgb(149, 149, 149);
  }

  .empty-title {
    color: rgb(231, 231, 231);
  }

  .empty-sub {
    color: rgb(115, 115, 115);
  }

  .empty-mini {
    color: rgb(115, 115, 115);
  }

  .dict-item {
    border-bottom-color: rgb(40, 40, 40);
  }

  .dict-zh {
    color: rgb(231, 231, 231);
  }

  .dict-arrow {
    color: rgb(99, 99, 99);
  }

  .dict-es {
    color: rgb(180, 180, 180);
  }

  .search-input {
    background: rgb(40, 40, 40);
    color: rgb(231, 231, 231);
  }

  .form-input {
    background: rgb(40, 40, 40);
    color: rgb(231, 231, 231);
  }

  .provider-chip {
    background: rgb(40, 40, 40);
    color: rgb(149, 149, 149);
  }

  .provider-chip.on {
    background: rgba(0, 200, 80, 0.12);
    color: rgb(0, 200, 80);
    border-color: rgb(0, 200, 80);
  }

  .api-warn {
    background: rgba(255, 165, 0, 0.06);
    color: rgb(255, 200, 100);
  }

  .test-result {
    background: rgb(40, 40, 40);
  }

  .test-result-title {
    color: rgb(149, 149, 149);
  }

  .test-result-text {
    color: rgb(231, 231, 231);
  }

  .btn.secondary {
    background: rgb(17, 17, 17);
    color: rgb(0, 200, 80);
    border-color: rgb(0, 200, 80);
  }

  .btn.test-btn {
    background: rgb(17, 17, 17);
    color: rgb(0, 200, 80);
    border-color: rgb(0, 200, 80);
  }

  .modal {
    background: rgb(17, 17, 17);
  }

  .modal-title {
    color: rgb(231, 231, 231);
  }

  .whitelist-group-title {
    color: rgb(149, 149, 149);
  }

  .chip-builtin {
    background: rgb(40, 40, 40);
    color: rgb(149, 149, 149);
  }

  .chip-removable {
    background: rgba(0, 200, 80, 0.12);
    color: rgb(0, 200, 80);
    border-color: rgba(0, 200, 80, 0.3);
  }

  .chip-x {
    color: rgb(0, 200, 80);
  }

  .whitelist-input {
    background: rgb(40, 40, 40);
    color: rgb(231, 231, 231);
  }

  .prompt-section {
    border-top-color: rgb(40, 40, 40);
  }

  .form-textarea {
    background: rgb(40, 40, 40);
    color: rgb(231, 231, 231);
  }

  .placeholder-tag {
    background: rgba(0, 200, 80, 0.15);
    color: rgb(0, 200, 80);
  }

  .prompt-preview {
    background: rgb(40, 40, 40);
    border-left-color: rgb(0, 200, 80);
  }

  .prompt-preview-title {
    color: rgb(149, 149, 149);
  }

  .prompt-preview-text {
    color: rgb(180, 180, 180);
  }
}
