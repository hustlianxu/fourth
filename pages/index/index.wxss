.hero {
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  color: #fff;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.92;
}

.tpl-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.tpl-item {
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  position: relative;
  transition: all 0.2s;
}

.tpl-item:active {
  opacity: 0.85;
}

.tpl-item.selected {
  border-color: #07c160;
  background: #eafff3;
}

.tpl-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

.tpl-name {
  font-size: 30rpx;
  font-weight: 600;
}

.tpl-desc {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.tpl-tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  background: #e6f7ee;
  color: #07c160;
  border-radius: 999rpx;
}

.btn.outline {
  background: #fff;
  color: #07c160;
  border: 2rpx solid #07c160;
}

.footer {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  margin-top: 48rpx;
}

@import './index-wxa-auto-dark.wxss'
