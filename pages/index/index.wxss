/* ===== 页面容器+滑动 ===== */
.page-wrap {
  position: relative;
  width: 100%;
  min-height: 100vh;
  overflow: hidden;
}

/* ===== 侧滑浮层 ===== */
.slide-panel {
  position: fixed;
  top: 0;
  bottom: 0;
  width: 100%;
  z-index: 0;
  display: flex;
  flex-direction: column;
  background: #fff;
}

.list-panel {
  left: 0;
  background: #f5f6fa;
}

.camera-panel {
  right: 0;
  background: linear-gradient(135deg, #555 0%, #222 100%);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  padding-top: calc(24rpx + env(safe-area-inset-top));
  border-bottom: 2rpx solid #eee;
  background: inherit;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
}

.panel-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}

.panel-body {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx 24rpx;
}

.panel-record {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.panel-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  background: #eee;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.panel-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.panel-name {
  font-size: 28rpx;
  color: #222;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel-meta {
  font-size: 24rpx;
  color: #888;
}

.panel-empty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #888;
  font-size: 28rpx;
}

.panel-footer {
  text-align: center;
  color: #07c160;
  font-size: 30rpx;
  font-weight: 500;
  padding: 28rpx 0;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #eee;
  background: inherit;
}

/* 拍照浮层 */
.camera-preview-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.camera-preview-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.5;
}

.camera-preview-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
}

.container {
  position: relative;
  z-index: 1;
  background: #f5f6fa;
  min-height: 100vh;
}

.hero {
  background: linear-gradient(135deg, #07c160 0%, #10b981 100%);
  color: #fff;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.92;
}

.tpl-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.tpl-item {
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  position: relative;
  transition: all 0.2s;
}

.tpl-item:active {
  opacity: 0.85;
}

.tpl-item.selected {
  border-color: #07c160;
  background: #eafff3;
}

.tpl-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

.tpl-name {
  font-size: 30rpx;
  font-weight: 600;
}

.tpl-desc {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.tpl-tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  background: #e6f7ee;
  color: #07c160;
  border-radius: 999rpx;
}

.btn.outline {
  background: #fff;
  color: #07c160;
  border: 2rpx solid #07c160;
}

.footer {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  margin-top: 48rpx;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 24rpx;
}

.setting-info {
  flex: 1;
}

.setting-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.setting-desc {
  font-size: 24rpx;
  color: #888;
  margin-top: 6rpx;
  line-height: 1.5;
}

/* ===== 暗黑模式 ===== */
@media (prefers-color-scheme: dark) {
  .hero {
    background: linear-gradient(135deg, rgb(0, 105, 12) 0%, rgb(5, 80, 40) 100%);
    color: rgb(255, 255, 255);
  }

  .tpl-item {
    background: rgb(22, 22, 24);
  }

  .tpl-item.selected {
    border-color: rgb(0, 105, 12);
    background: rgb(5, 25, 15);
  }

  .tpl-check {
    background: rgb(0, 105, 12);
    color: rgb(255, 255, 255);
  }

  .tpl-name {
    color: rgb(231, 231, 231);
  }

  .tpl-desc {
    color: rgb(149, 149, 149);
  }

  .tag {
    background: rgb(16, 29, 23);
    color: rgb(0, 105, 12);
  }

  .btn.outline {
    background: rgb(17, 17, 17);
    color: rgb(0, 105, 12);
    border: 2rpx solid rgb(0, 105, 12);
  }

  .container {
    background: rgb(17, 17, 17);
  }

  .list-panel {
    background: rgb(17, 17, 17);
  }

  .panel-header {
    border-bottom-color: rgb(40, 40, 40);
  }

  .panel-title {
    color: rgb(231, 231, 231);
  }

  .panel-record {
    border-bottom-color: rgb(40, 40, 40);
  }

  .panel-name {
    color: rgb(231, 231, 231);
  }

  .panel-footer {
    border-top-color: rgb(40, 40, 40);
  }

  .footer {
    color: rgb(99, 99, 99);
  }

  .setting-title {
    color: rgb(231, 231, 231);
  }

  .setting-desc {
    color: rgb(149, 149, 149);
  }
}
