.camera-wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.camera {
  width: 100%;
  height: 60vh;
  background: #000;
}

.preview {
  width: 100%;
  height: 60vh;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.panel {
  background: #fff;
  padding: 24rpx;
  border-radius: 24rpx 24rpx 0 0;
  margin-top: -24rpx;
  position: relative;
  flex: 1;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.04);
}

.title-sm {
  font-size: 30rpx;
  font-weight: 600;
}

.fields {
  margin: 16rpx 0 24rpx;
}

.field {
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.f-label {
  font-size: 26rpx;
  color: #555;
  margin-bottom: 8rpx;
}

.req {
  color: #ff4d4f;
  margin-left: 8rpx;
}

.f-input {
  background: #f7f8fa;
  padding: 16rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.mini-btn {
  background: #e6f7ee;
  color: #07c160;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
  font-size: 26rpx;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

.picker {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  z-index: 101;
  max-height: 70vh;
  overflow: auto;
}

.picker-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.picker-item {
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  margin-bottom: 12rpx;
}

.picker-item.selected {
  background: #eafff3;
  border: 2rpx solid #07c160;
}

.offscreen {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750rpx;
  height: 750rpx;
}
