/* ===== 整体布局 ===== */
.camera-wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #000;
  position: relative;
}

/* ===== 相机画面 ===== */
.camera {
  width: 100%;
  height: 72vh;
  background: #000;
}

/* ===== 水印位置选择器（叠加在相机画面右下角） ===== */
.pos-panel {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  z-index: 50;
}

.pos-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 8rpx;
  text-align: center;
}

.pos-grid {
  display: grid;
  grid-template-columns: repeat(3, 32rpx);
  grid-template-rows: repeat(3, 32rpx);
  gap: 6rpx;
}

.pos-dot {
  background: rgba(255,255,255,0.25);
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.3);
  transition: background 0.15s;
}

.pos-dot.active {
  background: #07c160;
  border-color: #07c160;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.12);
  z-index: 60;
  transition: all 0.25s ease;
  max-height: 100rpx;
  overflow: hidden;
}

.bottom-bar.open {
  max-height: 75vh;
}

/* 收起时的概要行 */
.summary-row {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
}

.summary-tags {
  display: flex;
  flex-wrap: nowrap;
  overflow: hidden;
  flex: 1;
  gap: 8rpx;
}

.sum-tag {
  display: inline-block;
  padding: 6rpx 12rpx;
  background: #e6f7ee;
  color: #07c160;
  border-radius: 999rpx;
  font-size: 22rpx;
  white-space: nowrap;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.expand-tag {
  font-size: 24rpx;
  color: #07c160;
  font-weight: 500;
  padding-left: 8rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 展开的表单区域 */
.form-body {
  padding: 0 24rpx 24rpx;
  max-height: calc(75vh - 88rpx);
  overflow-y: auto;
}

.fields {
  margin-bottom: 20rpx;
}

.field {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.f-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
}

.req {
  color: #ff4d4f;
  margin-left: 6rpx;
}

.f-input {
  background: #f7f8fa;
  padding: 14rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.f-textarea {
  background: #f7f8fa;
  padding: 14rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 100rpx;
  line-height: 1.5;
}

.mini-btn {
  background: #e6f7ee;
  color: #07c160;
  padding: 10rpx 18rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  flex-shrink: 0;
  margin-left: 10rpx;
}

.form-actions {
  display: flex;
  gap: 16rpx;
}

.bottom-actions {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
  width: 280rpx;
}

/* ===== 底部按钮 ===== */
.btn {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  padding: 22rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  flex: 1;
}

.btn.secondary {
  background: #fff;
  color: #07c160;
  border: 2rpx solid #07c160;
}

/* ===== 预览页 ===== */
.preview {
  width: 100%;
  height: 72vh;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx;
  z-index: 60;
}

.title-sm {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.muted {
  color: #888;
  font-size: 24rpx;
}

/* ===== 弹层 ===== */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 100;
}

.picker {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  z-index: 101;
  max-height: 70vh;
  overflow: auto;
}

.picker-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.picker-item {
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  margin-bottom: 12rpx;
}

.picker-item.selected {
  background: #eafff3;
  border: 2rpx solid #07c160;
}

.tpl-name { font-size: 28rpx; font-weight: 600; }
.tpl-desc { font-size: 24rpx; color: #666; margin-top: 4rpx; }

/* ===== 离屏画布 ===== */
.offscreen {
  position: fixed;
  left: -9999px;
  top: -9999px;
}
