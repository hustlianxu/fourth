<view class="camera-wrap">
  <!-- 阶段一：拍照 -->
  <block wx:if="{{stage === 'camera'}}">
    <camera
      class="camera"
      device-position="back"
      flash="auto"
      resolution="medium"
    ></camera>

    <view class="panel">
      <view class="row between">
        <view class="title-sm" bindtap="onTplTap">模板：{{template.name}} ▾</view>
        <view class="muted" bindtap="onRefreshTime">刷新时间</view>
      </view>

      <view class="fields">
        <block wx:for="{{template.fields}}" wx:key="key">
          <view class="field">
            <view class="f-label">
              <text>{{item.label}}</text>
              <text class="req" wx:if="{{item.required}}">*</text>
            </view>
            <block wx:if="{{item.type === 'text' || item.type === 'number'}}">
              <input
                class="f-input"
                type="{{item.type === 'number' ? 'digit' : 'text'}}"
                placeholder="{{item.placeholder || '请输入' + item.label}}"
                value="{{values[item.key]}}"
                data-key="{{item.key}}"
                bindinput="onFieldInput"
              />
            </block>
            <block wx:elif="{{item.type === 'datetime' || item.type === 'date' || item.type === 'time'}}">
              <input
                class="f-input"
                placeholder="请输入"
                value="{{values[item.key]}}"
                data-key="{{item.key}}"
                bindinput="onFieldInput"
              />
            </block>
            <block wx:elif="{{item.type === 'location'}}">
              <view class="row">
                <input
                  class="f-input"
                  style="flex:1;"
                  placeholder="点击右侧按钮获取定位"
                  value="{{values[item.key]}}"
                  data-key="{{item.key}}"
                  bindinput="onFieldInput"
                />
                <view class="mini-btn" bindtap="onGetLocation">获取定位</view>
              </view>
            </block>
            <block wx:elif="{{item.type === 'select'}}">
              <picker
                mode="selector"
                range="{{item.options}}"
                data-key="{{item.key}}"
                data-range="{{item.options}}"
                bindchange="onSelectChange"
              >
                <view class="f-input">{{values[item.key] || '请选择'}}</view>
              </picker>
            </block>
          </view>
        </block>
      </view>

      <view class="row between">
        <view class="btn secondary" bindtap="onPickImage" style="flex:1;margin-right:16rpx;">
          从相册选
        </view>
        <view class="btn" bindtap="onTakePhoto" style="flex:1;">
          拍照
        </view>
      </view>
    </view>
  </block>

  <!-- 阶段二：预览 -->
  <block wx:else>
    <view class="preview">
      <image class="preview-img" src="{{photo}}" mode="aspectFit"></image>
    </view>
    <view class="panel">
      <view class="title-sm">确认保存</view>
      <view class="muted">点击下方按钮将把水印数据写入照片并入库保存。</view>
      <view class="row between" style="margin-top:24rpx;">
        <view class="btn secondary" bindtap="onRetake" style="flex:1;margin-right:16rpx;">
          重拍
        </view>
        <view class="btn" bindtap="onSave" style="flex:1;">
          保存水印照片
        </view>
      </view>
    </view>
  </block>
</view>

<!-- 模板选择弹层 -->
<view class="mask" wx:if="{{showTplPicker}}" bindtap="closePicker"></view>
<view class="picker" wx:if="{{showTplPicker}}">
  <view class="picker-title">选择模板</view>
  <view class="picker-list">
    <view
      wx:for="{{templates}}"
      wx:key="id"
      class="picker-item {{template.id === item.id ? 'selected' : ''}}"
      data-id="{{item.id}}"
      bindtap="onPickTemplate"
    >
      <view class="tpl-name">{{item.name}}</view>
      <view class="tpl-desc">{{item.description}}</view>
    </view>
  </view>
  <view class="btn secondary" bindtap="closePicker" style="margin-top:16rpx;">关闭</view>
</view>

<!-- 离屏 Canvas（不展示给用户，仅用于合成水印） -->
<canvas
  type="2d"
  id="wmCanvas"
  class="offscreen"
></canvas>
