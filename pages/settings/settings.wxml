<!-- pages/settings/settings.wxml -->
<view class="page">


  <view class="section">
    <view class="section-header">云同步</view>

    <view class="row">
      <view class="row-left">
        <text class="row-title">启用水印照片同步</text>
        <text class="row-desc">同步照片、文件夹到所有设备</text>
      </view>
      <switch checked="{{syncEnabled}}" bindchange="onSyncToggle" color="#07c160" />
    </view>

    <view class="row">
      <view class="row-left">
        <text class="row-title">启用配置同步</text>
        <text class="row-desc">同步自动保存、翻译引擎（含 API Key）、自定义词典、提示词等全部配置</text>
      </view>
      <switch checked="{{configSyncEnabled}}" bindchange="onConfigSyncToggle" color="#07c160" />
    </view>

    <view class="row" wx:if="{{syncEnabled || configSyncEnabled}}">
      <view class="row-left">
        <text class="row-title">最后同步时间</text>
        <text class="row-desc">{{lastSyncText || '尚未同步'}}</text>
      </view>
    </view>

    <view class="row" wx:if="{{syncEnabled || configSyncEnabled}}">
      <view class="row-left">
        <text class="row-title">当前用户</text>
        <text class="row-desc">{{openid || '未获取'}}</text>
      </view>
    </view>

    <button class="sync-btn" wx:if="{{syncEnabled || configSyncEnabled}}" bindtap="onManualSync"
      loading="{{syncing}}" disabled="{{syncing}}">
      {{syncing ? '同步中...' : '立即同步'}}
    </button>
  </view>

  <!-- ===== 云端导出文件 ===== -->
  <view class="section" wx:if="{{syncEnabled || configSyncEnabled || exports.length > 0}}">
    <view class="section-header">云端导出文件</view>
    <view wx:if="{{exports.length === 0}}" class="empty-tip">
      暂无导出记录。在列表页选择记录 → 导出 → 「xlsx + 上传到云端」即可生成。
    </view>
    <view wx:for="{{exports}}" wx:key="fileID" class="export-item">
      <view class="export-info">
        <text class="export-name">{{item.fileName}}</text>
        <text class="export-time">{{_formatLastSync(item.createdAt) || ''}}</text>
      </view>
      <view class="export-actions">
        <button class="btn-sm" bindtap="onDownloadExport" data-fileid="{{item.fileID}}" data-filename="{{item.fileName}}">下载</button>
        <button class="btn-sm btn-sm-del" bindtap="onDeleteExport" data-fileid="{{item.fileID}}">移除</button>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">关于</view>
    <view class="row">
      <view class="row-left">
        <text class="row-title">数据存储</text>
        <text class="row-desc">照片存储在微信云开发，按量付费，月均不到 1 元</text>
      </view>
    </view>
    <view class="row">
      <view class="row-left">
        <text class="row-title">数据隔离</text>
        <text class="row-desc">每个用户数据独立，可授权给他人</text>
      </view>
    </view>
  </view>
</view>
