/* pages/share/share.wxss */
.page {
  padding: 0 32rpx 40rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.record-info {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  align-items: center;
}

.record-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  background: #eee;
}

.record-body {
  flex: 1;
}

.record-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.record-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  margin-top: 24rpx;
  padding: 0 32rpx 24rpx;
}

.section-header {
  font-size: 26rpx;
  color: #999;
  padding: 28rpx 0 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 16rpx;
}

.form-row {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.form-input {
  width: 100%;
  background: #f7f8fa;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #222;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  background: #f7f8fa;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #222;
  box-sizing: border-box;
  line-height: 1.6;
}

.form-picker {
  background: #f7f8fa;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
}

.picker-value {
  color: #222;
}

.btn-primary {
  width: 100%;
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
  margin-top: 8rpx;
}

.btn-primary[disabled] {
  background: #ccc;
}

.btn-secondary {
  width: 100%;
  background: #f5f5f5;
  color: #333;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: 2rpx solid #ddd;
  box-sizing: border-box;
}

.btn-secondary:active {
  background: #eaeaea;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 32rpx 0;
}

.auth-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.auth-row:last-child {
  border-bottom: none;
}

.auth-info {
  flex: 1;
  min-width: 0;
}

.auth-openid {
  font-size: 26rpx;
  color: #333;
  display: block;
  word-break: break-all;
}

.auth-perm {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-top: 6rpx;
}

.auth-perm.perm-read { background: #e6f7ff; color: #1890ff; }
.auth-perm.perm-write { background: #fff7e6; color: #fa8c16; }
.auth-perm.perm-readwrite { background: #f6ffed; color: #52c41a; }

.auth-time {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.auth-actions {
  margin-left: 16rpx;
}

.btn-sm {
  background: #ff4d4f;
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 8rpx;
}
