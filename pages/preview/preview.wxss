/* 预览页面容器 */
.preview-page {
  min-height: 100vh;
  background: #000;
  display: flex;
  flex-direction: column;
}

/* 顶部工具栏 */
.toolbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx;
  padding-top: calc(48rpx + env(safe-area-inset-top));
  background: rgba(0,0,0,0.7);
  z-index: 100;
}

.back-btn {
  position: fixed;
  font-size: 28rpx;
  color: #fff;
  padding: 0 20rpx;
  z-index: 101;
  display: flex;
  align-items: center;
}

.toolbar-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.save-btn {
  position: fixed;
  background: #07c160;
  color: #fff;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  z-index: 101;
}

/* 预览区域 */
.preview-area {
  flex: 1;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: calc(80rpx + env(safe-area-inset-top));
  padding-bottom: 0;
}

.img-container {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-img {
  width: 100%;
  height: 100%;
  background: #1a1a1a;
}

/* 可拖动水印层 */
.watermark-layer {
  position: absolute;
  background: rgba(0,0,0,0.75);
  border-radius: 16rpx;
  padding: 16rpx;
  z-index: 50;
  min-width: 200rpx;
  transform-origin: top left;
  border: 2rpx solid rgba(255,255,255,0.3);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.4);
  transition: border-color 0.2s, box-shadow 0.2s;
}

.watermark-layer.dragging {
  border-color: rgba(7,193,96,0.7);
  box-shadow: 0 6rpx 24rpx rgba(7,193,96,0.3);
}

/* 拖拽手柄 */
.wm-drag-handle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
  margin-bottom: 10rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.15);
}

.wm-drag-dots {
  display: flex;
  gap: 4rpx;
}

.wm-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.5);
}

.wm-drag-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
}

.wm-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.wm-row {
  display: flex;
  flex-direction: column;
}

.wm-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}

.wm-value {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

.wm-resize-hint {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
  text-align: center;
  margin-top: 8rpx;
  border-top: 1rpx solid rgba(255,255,255,0.1);
  padding-top: 8rpx;
}

/* 底部操作面板 */
.bottom-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.15);
  z-index: 100;
  transition: all 0.25s ease;
}

.bottom-panel.collapsed {
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

/* 面板标题栏（可点击折叠） */
.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx 16rpx;
}

.bottom-panel.collapsed .panel-header {
  padding-bottom: 16rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
}

.panel-toggle {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f8fa;
  border-radius: 50%;
}

.toggle-icon {
  font-size: 24rpx;
  color: #999;
}

/* 面板内容区 */
.panel-content {
  padding: 0 24rpx 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.setting-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.setting-label {
  font-size: 26rpx;
  color: #666;
  width: 140rpx;
  flex-shrink: 0;
}

.scale-slider,
.opacity-slider {
  flex: 1;
  margin: 0 16rpx;
}

.scale-value,
.opacity-value {
  font-size: 24rpx;
  color: #07c160;
  width: 80rpx;
  text-align: right;
}

.pos-quick {
  margin-top: 8rpx;
}

.pos-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 12rpx;
}

.pos-btn {
  padding: 14rpx;
  background: #f7f8fa;
  border-radius: 10rpx;
  text-align: center;
  font-size: 24rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.pos-btn.active {
  background: #e6f7ee;
  color: #07c160;
  border-color: #07c160;
}

.pos-btn:active {
  background: #e6f7ee;
  color: #07c160;
}

