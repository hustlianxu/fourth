/* 预览页面容器 */
.preview-page {
  min-height: 100vh;
  background: #000;
  display: flex;
  flex-direction: column;
}

/* 顶部工具栏 */
.toolbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  padding-top: calc(16rpx + env(safe-area-inset-top));
  background: rgba(0,0,0,0.7);
  z-index: 100;
}

.back-btn {
  font-size: 28rpx;
  color: #fff;
  padding: 12rpx 20rpx;
}

.toolbar-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.save-btn {
  background: #07c160;
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
}

/* 预览区域 */
.preview-area {
  flex: 1;
  position: relative;
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
}

/* 可拖动水印层 */
.watermark-layer {
  position: absolute;
  background: rgba(0,0,0,0.7);
  border-radius: 16rpx;
  padding: 16rpx;
  cursor: move;
  touch-action: none;
  z-index: 50;
  min-width: 200rpx;
}

.wm-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.wm-row {
  display: flex;
  flex-direction: column;
}

.wm-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}

.wm-value {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

.wm-resize-hint {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
  text-align: center;
  margin-top: 8rpx;
  border-top: 1rpx solid rgba(255,255,255,0.1);
  padding-top: 8rpx;
}

/* 底部操作面板 */
.bottom-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.15);
  z-index: 100;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.setting-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.setting-label {
  font-size: 26rpx;
  color: #666;
  width: 140rpx;
  flex-shrink: 0;
}

.scale-slider,
.opacity-slider {
  flex: 1;
  margin: 0 16rpx;
}

.scale-value,
.opacity-value {
  font-size: 24rpx;
  color: #07c160;
  width: 80rpx;
  text-align: right;
}

.pos-quick {
  margin-top: 8rpx;
}

.pos-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 12rpx;
}

.pos-btn {
  padding: 14rpx;
  background: #f7f8fa;
  border-radius: 10rpx;
  text-align: center;
  font-size: 24rpx;
  color: #666;
}

.pos-btn:active {
  background: #e6f7ee;
  color: #07c160;
}

/* 离屏画布 */
.offscreen {
  position: fixed;
  left: -9999px;
  top: -9999px;
}
