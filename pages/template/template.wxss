/* 页面容器 */
.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.page.no-scroll {
  overflow: hidden;
  height: 100vh;
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  padding: 48rpx 32rpx;
  padding-top: calc(48rpx + env(safe-area-inset-top));
  color: #fff;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  display: block;
}

.subtitle {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 8rpx;
  display: block;
}

/* 列表区域 */
.list {
  padding: 24rpx;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.btn-add {
  background: #07c160;
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
}

/* 模板卡片 */
.template-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.tpl-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.tpl-actions {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}

.tpl-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.tpl-fields {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.field-tag {
  padding: 6rpx 14rpx;
  background: #f0f5ff;
  color: #1890ff;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.field-tag.more {
  background: #f5f5f5;
  color: #999;
}

.tpl-meta {
  display: flex;
  gap: 20rpx;
  font-size: 22rpx;
  color: #999;
}

/* 弹窗遮罩 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

/* 弹窗 */
.modal {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 60rpx;
  bottom: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  z-index: 101;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  max-height: calc(100vh - 120rpx);
  box-sizing: border-box;
  width: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.modal-header text {
  font-size: 32rpx;
  font-weight: 600;
}

.close-btn {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  flex: 1;
  padding: 24rpx;
  /* 滚动容器右侧内缩，使原生滚动条不遮挡字迹 */
  margin-right: 16px;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.btn {
  flex: 1;
  background: #07c160;
  color: #fff;
  padding: 22rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 30rpx;
  transition: opacity 0.15s, transform 0.1s;
}

.btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn.secondary {
  background: #f5f5f5;
  color: #666;
}

.btn.secondary:active {
  opacity: 0.7;
}

.btn.danger {
  background: #ff4d4f;
}

.btn.danger:active {
  opacity: 0.85;
}

/* 表单区块 */
.form-section {
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: block;
}

.section-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.mini-btn {
  background: #e6f7ee;
  color: #07c160;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  white-space: nowrap;
}

/* 表单项 */
.form-item {
  margin-bottom: 20rpx;
}

.form-row {
  display: flex;
  gap: 16rpx;
}

.form-item.half {
  flex: 1;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}

.form-input {
  width: 100%;
  background: #f7f8fa;
  padding: 24rpx 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  min-height: 88rpx;
  line-height: 1.5;
}

/* 位置选择网格 */
.pos-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.pos-btn {
  padding: 20rpx 16rpx;
  background: #f7f8fa;
  border-radius: 10rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  min-width: 0;
}

.pos-btn.active {
  background: #e6f7ee;
  border-color: #07c160;
  color: #07c160;
}

/* 颜色选择器 */
.color-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.color-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 3rpx solid #e8e8e8;
  transition: all 0.2s;
}

.color-btn.active {
  border-color: #07c160;
  box-shadow: 0 0 0 6rpx rgba(7, 193, 96, 0.2);
}

/* 字段列表 */
.field-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 新增模板字段映射提示条 */
.field-tip {
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #d46b08;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.field-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
  max-width: 100%;
}

.field-input-wrap {
  flex: 1 1 0;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
}

.field-input {
  width: 100%;
  max-width: 100%;
  background: #f7f8fa;
  padding: 20rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  min-height: 80rpx;
  box-sizing: border-box;
}

.field-type {
  padding: 18rpx 20rpx;
  background: #f7f8fa;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #666;
  min-width: 120rpx;
  text-align: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

.field-actions {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.field-remove {
  font-size: 40rpx;
  color: #ff4d4f;
  line-height: 1;
}

/* 删除确认弹窗 */
.delete-modal {
  position: fixed;
  left: 60rpx;
  right: 60rpx;
  top: 40%;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  z-index: 102;
}

.delete-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 12rpx;
}

.delete-desc {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  margin-bottom: 28rpx;
}

.delete-actions {
  display: flex;
  gap: 16rpx;
}

.delete-actions .btn {
  flex: 1;
}

/* ===== 暗黑模式 ===== */
@media (prefers-color-scheme: dark) {
  .page {
    background: rgb(23, 24, 26);
  }

  .header {
    background: linear-gradient(135deg, rgb(0, 105, 12) 0%, rgb(5, 80, 40) 100%);
    color: rgb(255, 255, 255);
  }

  .label {
    color: rgb(231, 231, 231);
  }

  .btn-add {
    background: rgb(0, 105, 12);
    color: rgb(255, 255, 255);
  }

  .template-card {
    background: rgb(17, 17, 17);
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
  }

  .tpl-name {
    color: rgb(231, 231, 231);
  }

  .tpl-actions {
    color: rgb(149, 149, 149);
  }

  .tpl-desc {
    color: rgb(149, 149, 149);
  }

  .field-tag {
    background: rgb(20, 40, 60);
    color: rgb(100, 150, 255);
  }

  .field-tag.more {
    background: rgb(40, 40, 40);
    color: rgb(149, 149, 149);
  }

  .tpl-meta {
    color: rgb(115, 115, 115);
  }

  .modal {
    background: rgb(17, 17, 17);
  }

  .modal-header {
    border-bottom-color: rgb(40, 40, 40);
  }

  .modal-header text {
    color: rgb(231, 231, 231);
  }

  .close-btn {
    color: rgb(149, 149, 149);
  }

  .modal-footer {
    border-top-color: rgb(40, 40, 40);
  }

  .section-title {
    color: rgb(231, 231, 231);
  }

  .form-label {
    color: rgb(149, 149, 149);
  }

  .form-input,
  .field-input {
    background: rgb(40, 40, 40);
    color: rgb(231, 231, 231);
  }

  .field-type {
    background: rgb(40, 40, 40);
    color: rgb(149, 149, 149);
  }

  .mini-btn {
    background: rgb(5, 25, 15);
    color: rgb(0, 105, 12);
  }

  .pos-btn {
    background: rgb(40, 40, 40);
    color: rgb(149, 149, 149);
  }

  .pos-btn.active {
    background: rgb(5, 25, 15);
    border-color: rgb(0, 105, 12);
    color: rgb(0, 105, 12);
  }

  .color-btn {
    border-color: rgb(55, 55, 55);
  }

  .delete-modal {
    background: rgb(17, 17, 17);
  }

  .delete-title {
    color: rgb(231, 231, 231);
  }

  .delete-desc {
    color: rgb(149, 149, 149);
  }

  .field-remove {
    color: rgb(255, 77, 79);
  }

  .field-tip {
    background: rgba(255, 167, 38, 0.12);
    border-color: rgba(255, 167, 38, 0.4);
    color: rgb(255, 183, 77);
  }
}

