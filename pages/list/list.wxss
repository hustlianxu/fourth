/* 骨架屏 */
.skeleton-list {
  padding: 24rpx 0;
}

.skeleton-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.skeleton-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #e8e8e8;
  flex-shrink: 0;
  animation: skeletonPulse 1.5s ease-in-out infinite;
}

.skeleton-body {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: #e8e8e8;
  animation: skeletonPulse 1.5s ease-in-out infinite;
}

.skeleton-line.w60 { width: 60%; }
.skeleton-line.w40 { width: 40%; }
.skeleton-line.w80 { width: 80%; }

@keyframes skeletonPulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.8; }
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 96rpx 32rpx;
}

.empty-icon {
  font-size: 96rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 16rpx;
}

.empty-sub {
  color: #888;
  font-size: 26rpx;
  margin-top: 8rpx;
}

/* ===== 文件夹Tab栏 ===== */
.folder-tabs {
  width: 100%;
  background: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 16rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.folder-tabs-inner {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
}

.folder-tab {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  white-space: nowrap;
  flex-shrink: 0;
  transition: all 0.2s;
}

.folder-tab.active {
  background: #07c160;
  color: #fff;
  font-weight: 500;
}

/* 导出模式下的文件夹选中状态 */
.folder-tab.export-selected {
  background: #07c160;
  color: #fff;
  font-weight: 500;
}

.folder-tab-add {
  width: 56rpx;
  height: 56rpx;
  padding: 0;
  justify-content: center;
  border: 2rpx dashed #ccc;
  background: #fafafa;
  font-size: 36rpx;
  line-height: 56rpx;
  font-weight: 300;
  color: #999;
  border-radius: 50%;
}

/* 文件夹空提示 */
.folder-empty {
  text-align: center;
  padding: 64rpx 32rpx;
  color: #bbb;
  font-size: 28rpx;
}

/* 记录卡片 */
.record {
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: stretch;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}

.record-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #eee;
  flex-shrink: 0;
}

.record-body {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.record-title {
  font-size: 30rpx;
  font-weight: 600;
}

.record-time {
  color: #888;
  font-size: 24rpx;
  margin-top: 4rpx;
}

.record-summary {
  color: #444;
  font-size: 24rpx;
  margin-top: 12rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

/* 导出模式提示 */
.export-hint {
  text-align: center;
  color: #07c160;
  font-size: 24rpx;
  padding: 8rpx 0;
  margin-bottom: 8rpx;
}

/* 导出模式 */
.export-bar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
}

.export-actions {
  display: flex;
  gap: 16rpx;
}

.export-link {
  color: #07c160;
  font-size: 26rpx;
  padding: 8rpx 0;
}

.export-info {
  font-size: 26rpx;
  color: #666;
  flex: 1;
  text-align: center;
}

.btn.export-confirm {
  background: #07c160;
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.record.export-selectable {
  padding-left: 12rpx;
}

.record.selected {
  background: #e6f7ee;
  border: 2rpx solid #07c160;
  box-shadow: 0 2rpx 12rpx rgba(7,193,96,0.15);
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  flex-shrink: 0;
  margin-right: 12rpx;
  align-self: center;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
}

.checkbox.checked {
  background: #07c160;
  border-color: #07c160;
}

/* ===== 弹层通用遮罩 ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

/* ===== 居中弹窗（文件夹/重命名/导出文件名） ===== */
.folder-modal {
  position: fixed;
  left: 60rpx;
  right: 60rpx;
  top: 35%;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  z-index: 102;
}

.folder-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 12rpx;
}

.folder-modal-desc {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.folder-modal-input {
  width: 100%;
  background: #f7f8fa;
  padding: 24rpx 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  min-height: 88rpx;
  line-height: 1.5;
  margin-bottom: 28rpx;
}

.folder-modal-actions {
  display: flex;
  gap: 16rpx;
}

.folder-modal-actions .btn {
  flex: 1;
  padding: 22rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 30rpx;
}

/* ===== 底部弹层（文件夹选择器） ===== */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 100;
}

.picker {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  z-index: 101;
  max-height: 70vh;
  overflow: auto;
}

.picker-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.picker-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.picker-item {
  padding: 20rpx 16rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
}

.picker-item:active {
  background: #e6f7ee;
}

.picker-item-disabled {
  opacity: 0.4;
  pointer-events: none;
}

.picker-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.picker-item-count {
  font-size: 24rpx;
  color: #888;
  margin-top: 4rpx;
}

.picker-empty {
  text-align: center;
  color: #bbb;
  font-size: 26rpx;
  padding: 32rpx 0;
}
