/* 右上角操作浮层按钮 - 绝对定位于图片右上角 */
.action-fab {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  transition: all 0.15s;
}

.action-fab:active {
  background: rgba(0, 0, 0, 0.65);
  transform: scale(0.92);
}

/* 浮层菜单遮罩 */
.action-menu-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.2);
  z-index: 199;
}

/* 浮层菜单 - 固定定位，出现在按钮下方 */
.action-menu {
  position: fixed;
  top: calc(200rpx + env(safe-area-inset-top));
  right: calc(16rpx + env(safe-area-inset-right));
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.15);
  z-index: 201;
  overflow: hidden;
  min-width: 200rpx;
}

.action-menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #333;
  gap: 12rpx;
}

.action-menu-item:active {
  background: #f5f5f5;
}

.action-menu-item.danger {
  color: #ff4d4f;
}

.action-menu-icon {
  font-size: 32rpx;
}

.img-area {
  position: relative;
  margin: 0 auto 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #eee;
  display: flex;
  justify-content: center;
  align-items: center;
}

.big-img {
  border-radius: 16rpx;
  background: #eee;
  display: block;
}

/* 编辑模式水印层 */
.detail-wm-layer {
  position: absolute;
  background: rgba(0,0,0,0.75);
  border-radius: 12rpx;
  padding: 10rpx 14rpx;
  z-index: 10;
  min-width: 160rpx;
  transform-origin: top left;
  border: 2rpx solid rgba(7,193,96,0.5);
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.4);
}

.detail-wm-handle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 6rpx;
  margin-bottom: 6rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.15);
}

.wm-drag-dots {
  display: flex;
  gap: 3rpx;
}

.wm-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.5);
}

.wm-drag-label {
  font-size: 18rpx;
  color: rgba(255,255,255,0.5);
}

.detail-wm-row {
  display: flex;
  flex-direction: column;
}

.detail-wm-row:last-child {
  margin-bottom: 0;
}

.detail-wm-row.wide {
  flex-direction: row;
  align-items: baseline;
}

.detail-wm-row.wide .detail-wm-label {
  flex-shrink: 0;
  margin-right: 6rpx;
}

/* 行高与 watermark.js 中 lineHeight=1.35 保持一致 */
.detail-wm-label {
  font-size: 20rpx;
  line-height: 1.35;
  color: rgba(255,230,140,0.85);
}

.detail-wm-value {
  font-size: 20rpx;
  line-height: 1.35;
  color: #fff;
}

.field-row {
  display: flex;
  padding: 12rpx 0;
  align-items: center;
  border-bottom: 2rpx solid #f0f0f0;
}

.field-row:last-child {
  border-bottom: none;
}

.f-k {
  width: 180rpx;
  color: #666;
  font-size: 26rpx;
  flex-shrink: 0;
}

.f-v {
  flex: 1;
  font-size: 28rpx;
  color: #222;
}

.f-edit {
  flex: 1;
  background: #f7f8fa;
  padding: 12rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #222;
}

.setting-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.setting-row:last-child {
  margin-bottom: 0;
}

.setting-label {
  font-size: 26rpx;
  color: #666;
  width: 100rpx;
  flex-shrink: 0;
}

.setting-row slider {
  flex: 1;
  margin: 0 16rpx;
}

.setting-val {
  font-size: 24rpx;
  color: #07c160;
  width: 80rpx;
  text-align: right;
}

.issue {
  color: #d46b08;
  font-size: 26rpx;
  margin-top: 8rpx;
}

/* ===== 暗黑模式 ===== */
@media (prefers-color-scheme: dark) {
  .action-fab {
    background: rgba(255, 255, 255, 0.15);
    color: rgb(231, 231, 231);
  }

  .action-fab:active {
    background: rgba(255, 255, 255, 0.25);
  }

  .action-menu {
    background: rgb(40, 40, 40);
    box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.4);
  }

  .action-menu-item {
    color: rgb(231, 231, 231);
  }

  .action-menu-item:active {
    background: rgb(55, 55, 55);
  }

  .action-menu-item.danger {
    color: rgb(255, 77, 79);
  }

  .img-area {
    background: rgb(30, 30, 30);
  }

  .big-img {
    background: rgb(30, 30, 30);
  }

  .field-row {
    border-bottom-color: rgb(40, 40, 40);
  }

  .f-k {
    color: rgb(149, 149, 149);
  }

  .f-v {
    color: rgb(231, 231, 231);
  }

  .f-edit {
    background: rgb(40, 40, 40);
    color: rgb(231, 231, 231);
    border: 1rpx solid rgb(55, 55, 55);
  }

  .setting-label {
    color: rgb(149, 149, 149);
  }

  .setting-val {
    color: rgb(0, 105, 12);
  }

  .issue {
    color: rgb(250, 173, 20);
  }
}
