/* 交易流水列表 */
.page { padding-bottom: 160rpx; }
.page-head { display: flex; flex-direction: column; }
.page-title { font-size: 40rpx; font-weight: 700; }
.page-desc { font-size: 24rpx; color: var(--text-secondary); margin-top: 8rpx; }

/* 汇总卡 */
.summary-card { display: flex; flex-direction: column; gap: 20rpx; }
.summary-row { display: flex; }
.summary-row-2 { padding-top: 16rpx; border-top: 1rpx dashed var(--border-color); }
.summary-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.summary-label { font-size: 22rpx; color: var(--text-tertiary); margin-bottom: 8rpx; }
.summary-value { font-size: 32rpx; font-weight: 600; }

/* 筛选 */
.filter-card { display: flex; gap: 16rpx; }
.filter-card picker { flex: 1; }
.filter-pill {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: var(--bg-input);
  border-radius: 12rpx;
  font-size: 26rpx;
}
.filter-arrow { font-size: 22rpx; color: var(--text-tertiary); }

/* 分组 */
.txn-group { padding-bottom: 12rpx; }
.group-date {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 600;
  margin-bottom: 12rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid var(--border-color);
}

/* 单条流水 */
.txn-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.txn-item:last-child { border-bottom: none; }
.txn-left { display: flex; align-items: center; flex: 1; min-width: 0; }
.txn-type-badge {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 16rpx;
  color: #fff;
  flex-shrink: 0;
}
.txn-buy { background: var(--color-down); }
.txn-out { background: var(--color-down); }
.txn-sell { background: var(--color-up); }
.txn-in { background: var(--color-up); }
.txn-flat { background: var(--text-tertiary); }

.txn-info { display: flex; flex-direction: column; min-width: 0; }
.txn-product { font-size: 28rpx; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.txn-meta { font-size: 22rpx; color: var(--text-tertiary); margin-top: 4rpx; }

.txn-right { display: flex; flex-direction: column; align-items: flex-end; }
.txn-amount { font-size: 30rpx; font-weight: 600; }
.txn-actions { margin-top: 8rpx; }
.txn-action-del {
  font-size: 22rpx;
  color: var(--text-tertiary);
  padding: 4rpx 12rpx;
}
.txn-action-del:active { color: var(--color-down); }

/* 空状态 */
.empty-state { align-items: center; }
.empty-hint { font-size: 24rpx; color: var(--text-tertiary); margin-top: 12rpx; }

/* 浮动添加按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--primary-color);
  color: #fff;
  font-size: 60rpx;
  text-align: center;
  line-height: 100rpx;
  box-shadow: 0 8rpx 24rpx rgba(108, 99, 255, 0.4);
}
.fab:active { opacity: 0.85; }
