/* 交易流水编辑 */
.page { padding-bottom: 40rpx; }
.page-title { font-size: 40rpx; font-weight: 700; }

.form-group { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: var(--text-secondary); display: block; margin-bottom: 8rpx; }

.input-field {
  width: 100%;
  padding: 24rpx;
  min-height: 88rpx;
  background: var(--bg-input);
  border-radius: 12rpx;
  border: 2rpx solid var(--border-color);
  font-size: 28rpx;
  box-sizing: border-box;
  color: var(--text-primary);
}

.picker-row {
  display: flex;
  justify-content: space-between;
  padding: 24rpx;
  background: var(--bg-input);
  border-radius: 12rpx;
  border: 2rpx solid var(--border-color);
}
.picker-arrow { font-size: 24rpx; color: var(--text-tertiary); }

.btn-primary {
  background: var(--primary-color);
  color: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  width: 100%;
  text-align: center;
}
.btn-primary:active { opacity: 0.85; }

.btn-delete {
  margin-top: 20rpx;
  background: transparent;
  color: var(--color-down);
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  width: 100%;
  border: 2rpx solid var(--color-down);
}

/* 名称搜索建议 */
.suggestions {
  margin-top: 8rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  max-height: 400rpx;
  overflow-y: auto;
}
.suggestion-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.suggestion-item:last-child { border-bottom: none; }
.suggestion-item:active { background: #f0eeff; }
.suggestion-left { display: flex; flex-direction: column; }
.suggestion-name { font-size: 28rpx; font-weight: 500; }
.suggestion-code { font-size: 22rpx; color: var(--text-tertiary); margin-top: 4rpx; }
.suggestion-type {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  color: #fff;
}
