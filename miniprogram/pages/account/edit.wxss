/* 账户编辑 */
.page { padding-bottom: 40rpx; }
.page-title { font-size: 40rpx; font-weight: 700; }

.form-group { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: #8e8e93; display: block; margin-bottom: 8rpx; }

.input-field {
  width: 100%;
  padding: 24rpx 24rpx;
  background: var(--bg-input);
  height: auto;
  border-radius: 12rpx;
  border: 2rpx solid var(--border-color);
  font-size: 28rpx;
  box-sizing: border-box;
  color: var(--text-primary);
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: var(--bg-input);
  height: auto;
  border-radius: 12rpx;
  border: 2rpx solid var(--border-color);
}
.picker-arrow { font-size: 24rpx; color: #8e8e93; }

.btn-primary {
  background: #6c63ff;
  color: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  width: 100%;
  text-align: center;
  margin-bottom: 20rpx;
}
.btn-delete {
  background: transparent;
  color: #f5222d;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  width: 100%;
  text-align: center;
  border: 2rpx solid #f5222d;
}
