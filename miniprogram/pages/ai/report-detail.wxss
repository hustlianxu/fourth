/* 报告详情 */
.page { padding-bottom: 40rpx; }
.page-title { font-size: 40rpx; font-weight: 700; }

.report-meta { margin-top: 16rpx; }
.report-meta text {
  display: block;
  font-size: 24rpx;
  color: #8e8e93;
  margin-bottom: 4rpx;
}

.risk-badge-row { margin-bottom: 20rpx; }

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin: 24rpx 0 12rpx;
}

.report-summary {
  font-size: 28rpx;
  line-height: 1.7;
  padding: 16rpx;
  background: #f8f8fa;
  border-radius: 12rpx;
}

.finding-row {
  padding: 8rpx 0;
  font-size: 26rpx;
  line-height: 1.5;
}

.report-content {
  font-size: 26rpx;
  line-height: 1.8;
}

.risk-badge-conservative { color: #52c41a; font-weight: 600; }
.risk-badge-steady { color: #1890ff; font-weight: 600; }
.risk-badge-aggressive { color: #fa8c16; font-weight: 600; }
.risk-badge-radical { color: #f5222d; font-weight: 600; }
.risk-badge-low { color: #52c41a; font-weight: 600; }
.risk-badge-medium { color: #1890ff; font-weight: 600; }
.risk-badge-high { color: #f5222d; font-weight: 600; }
