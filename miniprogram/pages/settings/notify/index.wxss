/* 推送设置 */
.page { padding-bottom: 40rpx; }
.page-title { font-size: 40rpx; font-weight: 700; }

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.setting-info { flex: 1; }
.setting-label { font-size: 28rpx; font-weight: 500; display: block; }
.setting-desc { font-size: 22rpx; color: #8e8e93; margin-top: 4rpx; display: block; }

.form-group { margin-top: 20rpx; }
.form-label { font-size: 24rpx; color: #8e8e93; display: block; margin-bottom: 8rpx; }
.input-field {
  width: 100%;
  padding: 20rpx 24rpx;
  background: var(--bg-input);
  border-radius: 12rpx;
  border: 2rpx solid var(--border-color);
  font-size: 28rpx;
  box-sizing: border-box;
  color: var(--text-primary);
}

.btn-primary {
  background: #6c63ff;
  color: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  width: 100%;
  text-align: center;
}

.notice { background: #f0eeff; }
.notice-text {
  font-size: 24rpx;
  color: #6e6e73;
  line-height: 1.6;
}
