/* LLM 配置页 */
.page { padding-bottom: 40rpx; }
.page-title { font-size: 40rpx; font-weight: 700; }
.page-desc {
  font-size: 24rpx;
  color: #8e8e93;
  margin-top: 12rpx;
  line-height: 1.6;
  display: block;
}

/* 提供商配置 */
.provider-header {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.provider-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 10rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.provider-name { flex: 1; font-size: 30rpx; font-weight: 600; }

/* 表单 */
.form-group {
  margin-top: 20rpx;
}
.form-label {
  font-size: 26rpx;
  color: #8e8e93;
  display: block;
  margin-bottom: 8rpx;
}
.input-field {
  width: 100%;
  padding: 20rpx 24rpx;
  background: var(--bg-input);
  border-radius: 12rpx;
  border: 2rpx solid var(--border-color);
  font-size: 28rpx;
  box-sizing: border-box;
  color: var(--text-primary);
}
.input-field.tall {
  padding: 28rpx 24rpx;
  color: var(--text-primary);
  line-height: 1.5;
  min-height: 96rpx;
}

/* 模型选择器 */
.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 24rpx;
  background: var(--bg-input);
  border-radius: 12rpx;
  border: 2rpx solid var(--border-color);
}
.picker-value {
  font-size: 28rpx;
  color: var(--text-primary);
  flex: 1;
}
.picker-arrow { font-size: 24rpx; color: #aeaeb2; margin-left: 12rpx; }

/* 安全提示 */
.security-note {
  display: flex;
  align-items: flex-start;
  background: #f0eeff;
}
.note-icon { font-size: 32rpx; margin-right: 16rpx; }
.note-text {
  flex: 1;
  font-size: 22rpx;
  color: #6e6e73;
  line-height: 1.6;
}
