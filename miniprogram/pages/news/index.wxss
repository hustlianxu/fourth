/* 资讯页样式 */
.page {
  padding-bottom: 40rpx;
}
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.page-title { font-size: 40rpx; font-weight: 700; }
.page-date { font-size: 24rpx; color: #8e8e93; }

/* 分类 Tabs */
.category-tabs {
  margin: 0 20rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
}
.tab-scroll {
  white-space: nowrap;
}
.tab-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 12rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  background: #f5f5f7;
  color: #6e6e73;
}
.tab-item.active {
  background: #6c63ff;
  color: #fff;
}

/* 资讯卡片 */
.news-card {
  margin: 0 20rpx 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}
.news-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.news-category {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  background: #f0f0f5;
}
.tag-market { background: #fff0e0; color: #fa8c16; }
.tag-industry { background: #e6f7ff; color: #1890ff; }
.tag-company { background: #f6ffed; color: #52c41a; }
.tag-policy { background: #f9f0ff; color: #722ed1; }
.tag-global { background: #fffbe6; color: #d4b106; }
.news-source {
  font-size: 22rpx;
  color: #aeaeb2;
  flex: 1;
}
.news-time {
  font-size: 22rpx;
  color: #aeaeb2;
}
.news-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  display: block;
}
.news-summary {
  font-size: 24rpx;
  color: #8e8e93;
  margin-top: 8rpx;
  line-height: 1.5;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 空状态 */
.empty-state { padding: 100rpx 0; }
.empty-content { text-align: center; }
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
.empty-desc {
  font-size: 24rpx;
  color: #aeaeb2;
  display: block;
  margin: 12rpx 0 32rpx;
}
.btn-secondary {
  display: inline-block;
  padding: 16rpx 40rpx;
  border: 2rpx solid #6c63ff;
  color: #6c63ff;
  border-radius: 12rpx;
  font-size: 26rpx;
}
