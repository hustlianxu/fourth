/* 持仓编辑 */
.page { padding-bottom: 40rpx; }
.page-title { font-size: 40rpx; font-weight: 700; }

.form-group { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: #8e8e93; display: block; margin-bottom: 8rpx; }

.input-field {
  width: 100%;
  padding: 24rpx 24rpx;
  min-height: 88rpx;
  background: var(--bg-input);
  border-radius: 12rpx;
  border: 2rpx solid var(--border-color);
  font-size: 28rpx;
  box-sizing: border-box;
  color: var(--text-primary);
}

.picker-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  
  background: var(--bg-input);
  border-radius: 12rpx;
  border: 2rpx solid var(--border-color);
}
.picker-arrow { font-size: 24rpx; color: #8e8e93; }

.btn-primary {
  background: #6c63ff;
  color: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  width: 100%;
  text-align: center;
}

/* 代码查询提示 */
.lookup-hint {
  font-size: 22rpx;
  color: #52c41a;
  margin-top: 6rpx;
  padding-left: 8rpx;
}

/* 名称搜索建议列表 */
.suggestions {
  margin-top: 8rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  max-height: 400rpx;
  overflow-y: auto;
}
.suggestion-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.suggestion-item:last-child { border-bottom: none; }
.suggestion-item:active { background: #f0eeff; }
.suggestion-left { display: flex; flex-direction: column; }
.suggestion-name { font-size: 28rpx; font-weight: 500; }
.suggestion-code { font-size: 22rpx; color: #aeaeb2; margin-top: 4rpx; }
.suggestion-type {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
