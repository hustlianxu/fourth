<!-- 持仓详情 -->
<view class="page">
  <view class="card" wx:if="{{holding._id}}">
    <view class="holding-header">
      <text class="holding-name">{{holding.product_name}}</text>
      <text class="holding-code">{{holding.product_code}}</text>
      <text class="tag {{tagClass(holding.product_type)}}">{{productTypeName(holding.product_type)}}</text>
    </view>

    <view class="price-row">
      <view class="price-item">
        <text class="price-label">现价</text>
        <text class="price-value {{priceColor}}">{{formatMoney(holding.current_price)}}</text>
      </view>
      <view class="price-item">
        <text class="price-label">成本</text>
        <text class="price-value">{{formatMoney(holding.cost_price)}}</text>
      </view>
      <view class="price-item">
        <text class="price-label">盈亏</text>
        <text class="price-value {{holding.pnl > 0 ? 'price-up' : (holding.pnl < 0 ? 'price-down' : '')}}">
          {{holding.pnl >= 0 ? '+' : ''}}{{formatMoney(holding.pnl)}}
        </text>
      </view>
    </view>

    <view class="info-grid">
      <view class="info-item">
        <text class="info-label">持有份额</text>
        <text class="info-value">{{formatQuantity(holding.shares)}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">市值</text>
        <text class="info-value">¥{{formatMoney(holding.market_value)}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">成本金额</text>
        <text class="info-value">¥{{formatMoney(holding.cost_value)}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">盈亏比例</text>
        <text class="info-value {{holding.pnl > 0 ? 'price-up' : (holding.pnl < 0 ? 'price-down' : '')}}">
          {{holding.pnl_percent >= 0 ? '+' : ''}}{{formatPercent(holding.pnl_percent)}}
        </text>
      </view>
      <view class="info-item">
        <text class="info-label">买入日期</text>
        <text class="info-value">{{holding.buy_date || '--'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">更新日期</text>
        <text class="info-value">{{formatDate(holding.price_updated_at, 'MM-DD')}}</text>
      </view>
    </view>

    <view class="action-buttons">
      <button class="btn-edit" bindtap="onEdit">编辑</button>
      <button class="btn-delete" bindtap="onDelete">删除</button>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text>持仓记录未找到</text>
  </view>
</view>
