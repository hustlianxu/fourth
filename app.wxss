/* app.wxss */
page {
  background: #f5f6fa;
  color: #222;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}

/* 字体层级体系
   .title    32rpx / 600  - 卡片标题
   .subtitle 28rpx / 500  - 副标题
   .body     28rpx / 400  - 正文（默认）
   .caption  24rpx / 400  - 辅助说明
   .mini     22rpx / 400  - 极小文字（标签等）
*/

.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  font-weight: 500;
}

.muted {
  color: #888;
  font-size: 24rpx;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.btn {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  transition: opacity 0.15s, transform 0.1s;
}

.btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn.secondary {
  background: #ffffff;
  color: #07c160;
  border: 2rpx solid #07c160;
}

.btn.secondary:active {
  opacity: 0.7;
}

.btn.danger {
  background: #ff4d4f;
  color: #fff;
}

.btn.danger:active {
  opacity: 0.85;
}

.btn[disabled] {
  background: #ddd;
  color: #888;
}

.row {
  display: flex;
  align-items: center;
}

.row.between {
  justify-content: space-between;
}

.divider {
  height: 2rpx;
  background: #eee;
  margin: 16rpx 0;
}

@import './app-wxa-auto-dark.wxss'
