/* app.wxss */
page {
  background: #f5f6fa;
  color: #222;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.btn {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
}

.btn.secondary {
  background: #ffffff;
  color: #07c160;
  border: 2rpx solid #07c160;
}

.btn.danger {
  background: #ff4d4f;
  color: #fff;
}

.btn[disabled] {
  background: #ddd;
  color: #888;
}

.row {
  display: flex;
  align-items: center;
}

.row.between {
  justify-content: space-between;
}

.muted {
  color: #888;
  font-size: 24rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.divider {
  height: 2rpx;
  background: #eee;
  margin: 16rpx 0;
}

@import './app-wxa-auto-dark.wxss'
