@media (prefers-color-scheme: dark) {
    page {
        background: rgb(23, 24, 26);
        color: rgb(231, 231, 231);
    }

    .card {
        background: rgb(17, 17, 17);
    }

    .btn {
        background: rgb(0, 105, 12);
        color: rgb(17, 17, 17);
    }

    .btn.secondary {
        background: rgb(17, 17, 17);
        color: rgb(0, 105, 12);
        border: rgb(0, 0, 0);
    }

    .btn.danger {
        background: rgb(208, 19, 45);
        color: rgb(17, 17, 17);
    }

    .btn[disabled] {
        background: rgb(42, 42, 42);
        color: rgb(115, 115, 115);
    }

    .muted {
        color: rgb(115, 115, 115);
    }

    .divider {
        background: rgb(29, 29, 29);
    }
}
